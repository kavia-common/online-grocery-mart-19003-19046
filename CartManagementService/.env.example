# Server configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# API Security
API_KEY=replace-with-secure-api-key

# Database (choose either DATABASE_URL or discrete PG* variables)
# DATABASE_URL=postgres://user:password@host:5432/dbname

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=cart_db

# Optional Pool and SSL
PGPOOL_MAX=10
PGPOOL_IDLE=30000
PGSSLMODE=disable   # use 'require' to enable SSL with rejectUnauthorized=false

# Migrations
AUTO_MIGRATE=true
